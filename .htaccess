<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Lindungi file konfigurasi sensitif
<FilesMatch "^\.env|composer\.(json|lock)|package(-lock)?\.json">
    Order allow,deny
    Deny from all
</FilesMatch>
